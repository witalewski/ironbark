# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in all required values.
# Run: cp .env.example .env.local
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Local example: postgresql://postgres:password@localhost:5432/ironbark
# Vercel Postgres / Neon / Supabase: copy the connection string from your dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ironbark"

# NextAuth secret — required in all environments (including local dev)
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"

# Resend API key — required for magic-link emails
# Sign up at https://resend.com, create an API key, paste it here
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The "from" address for sign-in emails (must be a verified domain in Resend)
# For local dev you can use the Resend sandbox: onboarding@resend.dev
EMAIL_FROM="noreply@yourdomain.com"

# ──────────────────────────────────────────────────────────────
# Optional — only needed if you override the default Next.js URL
# AUTH_URL="http://localhost:3000"
# ──────────────────────────────────────────────────────────────
